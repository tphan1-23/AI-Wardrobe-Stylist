# Copy to .env (never commit .env). Values come from your Supabase / Google AI / OpenWeatherMap dashboards.

# Client (Expo). Anon key is safe to ship in the app; Row Level Security protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge function secrets. Set with: supabase secrets set GEMINI_API_KEY=... (never in the app)
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
